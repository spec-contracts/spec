{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPEC conformance self-assessment report",
  "type": "object",
  "required": ["suite_id", "spec", "subject", "claims", "results", "summary"],
  "properties": {
    "$schema": {"type": "string"},
    "suite_id": {"type": "string", "minLength": 1},
    "spec": {"const": "0.1-alpha"},
    "subject": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id", "status"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "not-run"]},
          "detail": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "not_run"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "not_run": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
